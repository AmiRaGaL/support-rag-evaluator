# Database
DATABASE_URL="postgresql://support_rag_user:support_rag_password@localhost:5433/support_rag_dev?schema=public"

# API
PORT=3001
NODE_ENV=development
AUTH_ENABLED=false
API_AUTH_TOKEN=""

# LLM provider
# Real app/demo mode uses Groq. Set LLM_PROVIDER=deterministic only for
# offline fallback, tests, or CI without external provider secrets.
LLM_PROVIDER=groq
GROQ_API_KEY=""
GROQ_CHAT_MODEL="llama-3.1-8b-instant"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Eval judge
# Deterministic keeps evals offline and CI-safe. Set EVAL_JUDGE_PROVIDER=groq
# only when you explicitly want LLM-as-judge scoring and have GROQ_API_KEY set.
EVAL_JUDGE_PROVIDER=deterministic

# Embeddings
# Hosted app/demo mode uses Gemini embeddings. Set EMBEDDING_PROVIDER=deterministic
# only for offline fallback, tests, or CI.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_API_KEY=""
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_BASE_URL=""

# Dashboard
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
API_BASE_URL="http://localhost:3001"
# Local/demo only: NEXT_PUBLIC_* values are visible in browser JavaScript.
# Prefer API_AUTH_TOKEN on the Next.js server proxy for non-demo use.
NEXT_PUBLIC_API_AUTH_TOKEN=""
